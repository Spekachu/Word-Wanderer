generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model contexts {
  context_id          Int                 @id @default(autoincrement())
  context_description String?
  sentence_contexts   sentence_contexts[]
  word_contexts       word_contexts[]
}

model sentences {
  sentence_id            Int                      @id @default(autoincrement())
  level                  String?                  @db.VarChar(2)
  frequency_score        Int?
  sentence_contexts      sentence_contexts[]
  sentence_words         sentence_words[]
  sentences_translations sentences_translations[]
}

model users {
  user_id                Int                      @id @default(autoincrement())
  email                  String                   @unique @db.VarChar(255)
  hashed_password        String                   @db.VarChar(255)
  user_preferences       user_preferences?
  user_word_associations user_word_associations[]
}

model words {
  word_id                Int                      @id @default(autoincrement())
  part_of_speech         String?                  @db.VarChar(50)
  level                  String?                  @db.VarChar(2)
  frequency_score        Int?
  sentence_words         sentence_words[]
  user_word_associations user_word_associations[]
  word_contexts          word_contexts[]
  words_translations     words_translations[]
}

model sentence_contexts {
  sentence_id Int
  context_id  Int
  contexts    contexts  @relation(fields: [context_id], references: [context_id], onDelete: NoAction, onUpdate: NoAction)
  sentences   sentences @relation(fields: [sentence_id], references: [sentence_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([sentence_id, context_id])
}

model sentence_words {
  sentence_word_id Int        @id @default(autoincrement())
  sentence_id      Int?
  word_id          Int?
  sentences        sentences? @relation(fields: [sentence_id], references: [sentence_id], onDelete: NoAction, onUpdate: NoAction)
  words            words?     @relation(fields: [word_id], references: [word_id], onDelete: NoAction, onUpdate: NoAction)
}

model sentences_translations {
  translation_id      Int        @id @default(autoincrement())
  sentence_id         Int?
  language_code       String?    @db.Char(2)
  translation         String?
  literal_translation String?
  translation_rank    Int?
  grammatical_person  Int?
  grammatical_number  String?    @db.VarChar(2)
  verb_tense          String?    @db.VarChar(20)
  verb_mood           String?    @db.VarChar(20)
  sentences           sentences? @relation(fields: [sentence_id], references: [sentence_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grammatical_person, grammatical_number, verb_tense, verb_mood], map: "idx_sentences_translations_conjugation")
}

model user_word_associations {
  id              Int       @id @default(autoincrement())
  user_id         Int
  word_id         Int
  emoji           String?   @db.VarChar(8)
  highlight_color String?   @db.Char(7)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  language_codes  String[]
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  words           words     @relation(fields: [word_id], references: [word_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, word_id])
  @@index([user_id, word_id], map: "idx_user_word_associations_user_word")
}

model word_contexts {
  word_id    Int
  context_id Int
  contexts   contexts @relation(fields: [context_id], references: [context_id], onDelete: NoAction, onUpdate: NoAction)
  words      words    @relation(fields: [word_id], references: [word_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([word_id, context_id])
}

model words_translations {
  translation_id      Int     @id @default(autoincrement())
  word_id             Int?
  language_code       String? @db.Char(2)
  translation         String?
  literal_translation String?
  translation_rank    Int?
  words               words?  @relation(fields: [word_id], references: [word_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([language_code], map: "idx_language")
}

model user_preferences {
  id                Int       @id @default(autoincrement())
  user_id           Int?      @unique(map: "user_preferences_unique")
  part_of_speech    String?   @db.VarChar(50)
  cefr_level        String?   @db.VarChar(2)
  user_language     String?   @db.VarChar(2)
  learning_language String?   @db.VarChar(2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  zoom_level        Decimal?  @db.Decimal(3, 2)
  users             users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

view incomplete_translations_view {
  word_id             Int      @unique
  part_of_speech      String?  @db.VarChar(50)
  level               String?  @db.VarChar(2)
  frequency_score     Int?
  missing_languages   String[]
  available_languages String[]
  en_translation      String?
  de_translation      String?
  es_translation      String?
  fr_translation      String?
}

view words_missing_sentences_view {
  word_id                     Int      @unique
  part_of_speech              String?  @db.VarChar(50)
  level                       String?  @db.VarChar(2)
  frequency_score             Int?
  en_translation              String?
  de_translation              String?
  es_translation              String?
  fr_translation              String?
  total_sentences             BigInt?
  languages_missing_sentences String[]
  en_sentences                BigInt?
  de_sentences                BigInt?
  es_sentences                BigInt?
  fr_sentences                BigInt?
}

view sentence_word_translations_view {
  sentence_id         Int     @unique
  sentence_level      String? @db.VarChar(2)
  sentence_frequency  Int?
  en_sentence         String?
  en_sentence_literal String?
  de_sentence         String?
  de_sentence_literal String?
  es_sentence         String?
  es_sentence_literal String?
  fr_sentence         String?
  fr_sentence_literal String?
  words               Json?
}

view word_translations_view {
  word_id                Int     @unique
  part_of_speech         String? @db.VarChar(50)
  level                  String? @db.VarChar(2)
  frequency_score        Int?
  en_translation         String?
  en_literal_translation String?
  de_translation         String?
  de_literal_translation String?
  es_translation         String?
  es_literal_translation String?
  fr_translation         String?
  fr_literal_translation String?
}
